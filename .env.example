# ==============================================================================
# PathSnap Environment Configuration (Template)
# Duplicate this file as '.env' and populate with local configuration values.
# NEVER commit the actual '.env' file containing real secrets or environment paths.
# ==============================================================================

# Application Environment (development, staging, production)
PATHSNAP_ENV=development

# Server Configuration (Laptop 1 - Model & API Host)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_LOG_LEVEL=info

# Security / Token Secrets (Placeholder - Generate a cryptographically secure key for deployment)
API_SECRET_KEY=replace_with_secure_random_key_for_production
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Client / UI Configuration (Laptop 2 - Evaluator Interface Host)
UI_HOST=0.0.0.0
UI_PORT=8501
UI_API_BASE_URL=http://localhost:8000

# File Paths (Local filesystem paths relative to repository root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_EVALUATOR_DIR=data/evaluator
ARTIFACTS_DIR=artifacts
EXPERIMENTS_DIR=experiments
CONFIGS_DIR=configs

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FILE_PATH=experiments/logs/pathsnap.log

# Reproducibility Seed
RANDOM_SEED=42
